[users]
  *id {label: "bigint, not null"}
  user_name {label: "varchar, not null, uniq"}
  email {label: "varchar, not null, uniq" }
  phone_number {label: "integer, not null, uniq" }
  birthday {label: "date, not null"}
  display_name {label: "varchar, not null"}
  self_introduction {label: "varchar, not null" }
  profile_image {label: "image, not null"}
  website {label: "url"}
  avater_icon {label: "image, not null"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[follows] {bgcolor: "#92bbfc"}
  *id {label: "bigint, not null"}
  follower_id {label: "bigint, not null, FK(users)"}
  followee_id {label: "bigint, not null, FK(users)"} 
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[direct_messages] {bgcolor: "#92bbfc"}
  *id {label: "bigint, not null"}
  sender_id {label: "bigint, not null, FK(users)"}
  receiver_id {label: "bigint, not null, FK(users)"}
  dm_content {label: "varchar, not null" }
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[notifications] {bgcolor: "#92bbfc"}
  *id {label: "bigint, not null"}
  like_id {label: "bigint, not null, FK(likes)"}
  follower_id {label: "bigint, not null, FK(users)"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[tweets] {bgcolor: "#d0e0d0"}
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  content {label: "varchar(140), not null" }
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[retweets] {bgcolor: "#79b38f"}
  *id {label: "bigint, not null"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  user_id {label: "bigint, not null, FK(users)"}
  content {label: "varchar(140)" }
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[likes] {bgcolor: "#79b38f"}
  *id {label: "bigint, not null"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  user_id {label: "bigint, not null, FK(users)"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

[bookmarks] {bgcolor: "#79b38f"}
  *id {label: "bigint, not null"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  user_id {label: "bigint, not null, FK(users)"}
  created_at { label: "datatime, not null"}
  updated_at { label: "datatime, not null"}

# Cardinality    Syntax
# 0 or 1         ?
# exactly 1      1
# 0 or more      *
# 1 or more      +
users 1--* `tweets`
users 1--* `retweets`
users 1--* `likes`
users 1--* `bookmarks`
users 1--* `followers`
users 1--* `followees`
users 1--* `direct_messages`
users 1--* `notifications`
`tweets` 1--* `retweets`
`tweets` 1--* `likes`
`tweets` 1--* `bookmarks`